rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow users to read, create, and update their own user document
      allow read, create, update: if request.auth != null && request.auth.uid == userId;

      // Allow users to manage their own cases
      match /cases/{caseId} {
        allow list, read, write: if request.auth != null && request.auth.uid == userId;
        // Allow create if user is authenticated and it's their own user path
        allow create: if request.auth != null && request.auth.uid == userId;

        // Allow users to read and write messages within their own cases
        match /messages/{messageId} {
            allow list, read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
