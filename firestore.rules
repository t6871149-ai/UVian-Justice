rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow users to read and update their own document.
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // Allow any authenticated user to create their own user document.
      // The server-side code ensures the document ID matches the user's UID.
      allow create: if request.auth != null;

      // Allow users to manage their own cases
      match /cases/{caseId} {
        allow list, read, write: if request.auth != null && request.auth.uid == userId;
        // Allow create if user is authenticated and it's their own user path
        allow create: if request.auth != null && request.auth.uid == userId;

        // Allow users to read and write messages within their own cases
        match /messages/{messageId} {
            allow list, read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
