rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Allow users to manage their own cases
      match /cases/{caseId} {
        allow list, read, create, write: if request.auth != null && request.auth.uid == userId;

        // Allow users to read and write messages within their own cases
        match /messages/{messageId} {
            allow list, read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
