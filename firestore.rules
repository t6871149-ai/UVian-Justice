rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;

      // Allow users to list their own chats, and read/write individual chats
      match /chats/{chatId} {
        allow list, read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
