
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, deny all reads and writes from the client.
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow clients to read their own user document.
    // Writes are now handled by secure server actions using the Admin SDK.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow clients to read their own cases and the messages within them.
      match /cases/{caseId} {
        allow read, list: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
            allow read, list: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
